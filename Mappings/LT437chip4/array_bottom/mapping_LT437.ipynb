    "\n",
    "def map_cols(map_sorted):\n",
    "    # Calculate the mean and standard deviation for each row\n",
    "    std_dev = np.ceil(np.nanmax(map_sorted)/nr_cols)\n",
    "    warnings = []\n",
    "    for y, row in enumerate(map_sorted):\n",
    "        mean = np.nanmean(map_sorted[y])\n",
    "        for x, value in enumerate(row):\n",
    "            if not np.isnan(value):\n",
    "                if y < nr_rows-1: \n",
    "                    value_above = map_sorted[y+1, x]\n",
    "                    if not np.isnan(value_above) and value_above-value <= 1:\n",
    "                        warnings.append([value, value_above])  \n",
    "                if value > mean + std_dev / 2 and np.isnan(map_sorted[-1, x]):\n",
    "                    print('down [%d, %d] %d+-%d: %d' % (y, x, mean, std_dev, value))\n",
    "                    map_sorted[y+1:, x] = map_sorted[y:-1, x]\n",
    "                    map_sorted[y, x] = np.nan\n",
    "    return map_sorted, warnings\n",
    "\n",
    "# Example usage\n",
    "map, warnings = map_cols(map_sorted)\n",
    "print(warnings)"
   ]
